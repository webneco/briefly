# Copy to .env and fill in. The .env file is ignored by git.

# Tavily: https://app.tavily.com
TAVILY_API_KEY=

# The model that writes and checks the brief. Either Anthropic's API:
#   Claude:  https://api.anthropic.com/v1                                model claude-haiku-5-5
# or any OpenAI-compatible chat completions endpoint:
#   OpenAI:  https://api.openai.com/v1                                   model gpt-4o-mini
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai     model gemini-2.5-flash
#   Groq:    https://api.groq.com/openai/v1                              model llama-3.3-70b-versatile
#   Bifrost: http://localhost:8080/v1                                    model openai/gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional
# LLM_EFFORT=medium      # Claude only: how long the model thinks (low, medium, high, xhigh, max)
# LLM_FAST_MODEL=        # a quicker model for the two set-up steps; grouping, drafting and checking stay on LLM_MODEL
# PORT=8787
# BRIEFLY_CACHE=1        # reuse identical Tavily calls from .cache/ while developing
